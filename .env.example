# Public hostname pointed to this server. Caddy provisions HTTPS automatically.
DOMAIN=www.your-domain.example

# Use long, unique secrets. Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
PAYLOAD_SECRET=replace-with-a-different-long-random-hex-secret

# Local development only. Docker Compose provides the container database URL.
DATABASE_URL=postgres://elastictech:local-development-password@localhost:5432/elastictech
