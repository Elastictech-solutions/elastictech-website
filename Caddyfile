{$DOMAIN} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000"
  request_body {
    max_size 6MB
  }
  @sensitive path /.env /.env/* /.git /.git/* /backups /backups/* /sources /sources/*
  respond @sensitive 404
  reverse_proxy app:3000 {
    header_up X-Client-IP {remote_host}
  }
}
